# ================================================================
# Nexus Studio Platform Backend Environment Configuration
# ================================================================

# Application
PROJECT_NAME="Nexus Studio API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL in prod, aiosqlite for local testing if PG is unavailable)
# PostgreSQL example: postgresql+asyncpg://postgres:postgres@localhost:5432/studio_db
DATABASE_URL="sqlite+aiosqlite:///./studio.db"

# Storage Settings (local / s3 / supabase)
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="./uploads"

# Razorpay Configuration (Payments)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
