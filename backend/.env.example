# ================================================================
# Nexus Studio Platform Backend Environment Configuration
# ================================================================

# Application
PROJECT_NAME="Nexus Studio API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL in prod, aiosqlite for local testing if PG is unavailable)
# PostgreSQL example: postgresql+asyncpg://postgres:postgres@localhost:5432/studio_db
DATABASE_URL="sqlite+aiosqlite:///./studio.db"

# Storage Settings (local / s3 / supabase)
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="./uploads"

# Razorpay Configuration (Payments)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# AI Website Generation Engine
AI_GENERATION_ENABLED=false
ARTIFACT_STORAGE_PATH="builds"

# AI Provider API Keys (leave blank or populate with valid keys)
GEMINI_API_KEY=""
CEREBRAS_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# AI Task Routing
AI_ANALYSIS_PROVIDER="gemini"
AI_ANALYSIS_MODEL="gemini-2.0-flash-lite"
AI_PLANNING_PROVIDER="gemini"
AI_PLANNING_MODEL="gemini-2.0-flash"
AI_GENERATION_PROVIDER="cerebras"
AI_GENERATION_MODEL="llama3.3-70b"
AI_REVIEW_PROVIDER="groq"
AI_REVIEW_MODEL="llama-3.3-70b-versatile"
AI_FALLBACK_PROVIDER="openrouter"
AI_FALLBACK_MODEL="deepseek/deepseek-chat:free"

# Deployment Engine (Phase 14)
DEPLOYMENT_ENABLED=false
DEPLOYMENT_PROVIDER="simulated"
DEPLOYMENT_BASE_DOMAIN="nexusstudio.app"
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
NETLIFY_AUTH_TOKEN=""
NETLIFY_SITE_ID=""

# Admin Bootstrap (Phase 15)
ADMIN_EMAIL="chiragparmar5768@gmail.com"
ADMIN_INITIAL_PASSWORD=""
ADMIN_BOOTSTRAP_ENABLED=true

# Studio Public Contact & Notifications (Phase 15)
STUDIO_PHONE="7877794272"
STUDIO_WHATSAPP="7877794272"
CONTACT_NOTIFICATION_EMAIL="chiragparmar5768@gmail.com"

# Email / SMTP Service (Phase 15)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="chiragparmar5768@gmail.com"
SMTP_USE_TLS=true

